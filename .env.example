# ─────────────────────────────────────────────────────────────────────────────
# Copie este arquivo para .env e ajuste os valores.
#
# Para o ambiente LOCAL (docker-compose.yml) basta a ANTHROPIC_API_KEY — todo o
# restante já tem padrão embutido. As demais variáveis são usadas pelo
# docker-compose.prod.yml, no deploy em servidor.
# ─────────────────────────────────────────────────────────────────────────────

# ── Opcional: funcionalidade de IA ──────────────────────────────────────────
# Sem a chave o sistema funciona normalmente; apenas o botão
# "Sugerir descrição" informa que o assistente não está configurado.
ANTHROPIC_API_KEY=

# ── Deploy em servidor (docker-compose.prod.yml) ────────────────────────────

# Versão (tag) das imagens Docker a serem executadas.
KORP_VERSION=latest

# Credenciais do PostgreSQL. TROQUE a senha em qualquer ambiente real.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=troque-esta-senha

# Origem do frontend, usada na política de CORS das duas APIs.
# Precisa bater exatamente com o endereço pelo qual o usuário acessa o sistema.
FRONTEND_ORIGIN=https://korp.seudominio.com

# Portas publicadas no servidor.
FRONTEND_PORT=80
INVENTORY_PORT=5159
BILLING_PORT=5160

# Production desliga o Swagger. Use Development para deixá-lo acessível.
ASPNETCORE_ENVIRONMENT=Production

# Em produção o recomendado é aplicar as migrations pelo script SQL antes de
# subir os contêineres, mantendo esta opção em false.
DATABASE_AUTO_MIGRATE=false
